# The Anthropic API key, read from the environment by the SDK.
#
# Needed by:   Reference Agent Runs (the Launcher's Run button, `npm run run:scenario`)
#              post-Run narratives (POST /api/runs/:id/narrative)
#              World generation     (POST /api/worlds/generate, /worlds/new)
#
# Not needed by: anything else. Opening the app, replaying the golden Runs, editing or validating
#              World packs, connecting your own agent over MCP or the forwarder, and the whole test
#              suite all work with this unset. Generation returns 503 rather than failing obscurely.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Where World packs are read from and written to. Default: ./worldpacks
# AGENTSIM_PACKS_DIR=

# Optional. Where Runs and the agents registry are read from and written to. Default: ./data
# AGENTSIM_DATA_DIR=
